import pandas as pd
import matplotlib.pyplot as plt
from sqlalchemy import create_engine, text
import logging

# 1. Modular Configuration
class ForensicDataEngine:
    def __init__(self, uri):
        self.engine = create_engine(uri)
        logging.basicConfig(level=logging.INFO)

    def fetch_transaction_data(self, county_prefix='G', limit=30, offset=10000):
        query = text('''
            SELECT transaction_id, transfer_date, price, town_city, district, county
            FROM public.uk_land_registry_price_paid 
            WHERE COUNTY LIKE :prefix
            ORDER BY transaction_id ASC LIMIT :limit OFFSET :offset;
        ''')
        with self.engine.connect() as conn:
            return pd.read_sql(query, conn, params={"prefix": f"{county_prefix}%", "limit": limit, "offset": offset})

    def generate_stakeholder_report(self, df):
        # Professional UI/UX Alignment (Dark Theme + Gold Accents)
        plt.style.use('dark_background')
        fig, ax = plt.subplots(figsize=(14, 8))
        
        # Data Visualization Engineering
        ax.bar(df['town_city'], df['price'], color='#c8a96e', label='Sale Price')
        
        # Descriptive Statistics (The "Systems Accountant" Depth)
        mean_price = df['price'].mean()
        ax.axhline(mean_price, color='#3B9EFF', linestyle='--', label=f'Mean Price (£{mean_price:,.0f})')
        
        # Branding & Labelling for C-Suite Stakeholders
        ax.set_title('Forensic Valuation: Property Price Distribution (County G%)', fontsize=16, color='#c8a96e', pad=20)
        ax.set_ylabel('Forensic Valuation (£)', fontsize=12)
        ax.set_xlabel('Geographic Identifier (Town/City)', fontsize=12)
        ax.legend(frameon=True, facecolor='#0a0a0f', edgecolor='#c8a96e')
        plt.xticks(rotation=45, ha='right')
        plt.tight_layout()
        plt.show()

